DODU_DB_NAME=dodu
DODU_DB_USERNAME=dodu
DODU_DB_PASSWORD=
DODU_DB_PORT=5432
# Set this to the complete hosted PostgreSQL JDBC URL when deploying.
DODU_DB_URL=

DODU_ACCESS_CODE_PEPPER=
DODU_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 푸시(FCM). 기본은 꺼짐
DODU_FCM_ENABLED=false

# 서비스 계정 키 JSON 파일의 경로. 파일은 저장소 밖에 둔다
DODU_FCM_CREDENTIALS_PATH=
DODU_FCM_DRY_RUN=false

DODU_SWAGGER_ENABLED=true
